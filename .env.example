# Copy to .env and fill these in. Get an API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Access gate (required for any public deployment). Reviewers enter this code to sign in.
APP_ACCESS_CODE=change-me
# Signing secret for session cookies. Generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-to-a-long-random-hex

# Optional overrides:
# LABEL_VERIFIER_MODEL=claude-haiku-4-5     # default; sonnet/opus for higher-stakes review
# ANTHROPIC_BASE_URL=https://your-internal-proxy   # route model calls via a firewall proxy
# LABEL_VERIFIER_MAX_EDGE=2200              # image long-edge px cap (latency lever)
# LABEL_VERIFIER_CONCURRENCY=8              # parallel labels per batch
# LABEL_VERIFIER_MAX_BATCH=300              # max images per batch request
# APP_SESSION_TTL=28800                     # session lifetime in seconds (default 8h)
